# Yet Another WhosAtMyFeeder - Environment Configuration
# Copy this file to .env and update with your values

# Timezone
TZ=UTC

# Permissions (v2.5.0+)
# Containers now run as non-root (appuser). 
# Set these to your host user's UID and GID to avoid permission issues.
# Run 'id' on your host to find these values.
PUID=1000
PGID=1000

# Image channel
# `latest` is the stable release line. Use `dev` only when you intentionally
# want development builds and are prepared for incomplete or unstable changes.
YAWAMF_MONALITHIC_TAG=latest

# Docker Network - REQUIRED for MQTT/Frigate connectivity
# Set this to the name of the Docker network where your MQTT broker and Frigate run
# (e.g., the network created by your Frigate compose stack)
DOCKER_NETWORK=your_network_name

# Frigate Configuration
FRIGATE_URL=http://frigate:5000
# FRIGATE_AUTH_TOKEN=your-bearer-token-here  # Uncomment if Frigate requires auth

# MQTT Configuration
MQTT_SERVER=mqtt
MQTT_PORT=1883
MQTT_AUTH=false
# MQTT_USERNAME=your-username  # Uncomment if MQTT requires auth
# MQTT_PASSWORD=your-password  # Uncomment if MQTT requires auth

# Security is configured in the first-run wizard. Password authentication is
# recommended before exposing YA-WAMF outside a trusted local network. The old
# YA_WAMF_API_KEY mechanism is deprecated and will be removed in v3.0.
