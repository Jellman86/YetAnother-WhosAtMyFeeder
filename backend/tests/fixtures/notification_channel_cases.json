          "connected_email": null,
          "to_email": "me@example.org"
        }
      },
      "configured": {
        "discord": false,
        "telegram": false,
        "pushover": false,
        "email": true
      },
      "can_deliver": {
        "discord": false,
        "telegram": false,
        "pushover": false,
        "email": false
      }
    },
    {
      "name": "email by a connected account with no recipient",
      "notifications": {
        "email": {
          "use_oauth": true,
          "oauth_provider": "outlook",
          "connected_email": "me@example.org"
        }
      },
      "can_deliver": {
        "discord": false,
        "telegram": false,
        "pushover": false,
        "email": false
      }
    }
  ]
