{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yawamf-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yawamf-telemetry",
      "database_id": "410fe778-460c-4922-86d4-8ea94beb607c",
      "migrations_dir": "migrations/telemetry"
    },
    {
      "binding": "HEALTH_DB",
      "database_name": "yawamf-health-issues",
      "database_id": "07d320ce-39f6-4d5a-bf16-ddf1ad07a1e7",
      "migrations_dir": "migrations/health"
    }
  ],
  "ratelimits": [
    {
      "name": "HEARTBEAT_RATE_LIMITER",
      "namespace_id": "3103013410305830",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "HEALTH_RATE_LIMITER",
      "namespace_id": "5020066673955123",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false }
  },
  "vars": { "ALLOWED_ORIGIN": "*" }
}
