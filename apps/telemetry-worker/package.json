{
  "name": "yawamf-telemetry-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for YA-WAMF Telemetry",
  "main": "src/index.ts",
  "scripts": {
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "npm run check && node --test test/*.test.mjs",
    "db:init": "wrangler d1 migrations apply yawamf-telemetry --local",
    "db:health:init": "wrangler d1 migrations apply yawamf-health-issues --local",
    "db:migrate:telemetry": "wrangler d1 migrations apply yawamf-telemetry --remote",
    "db:migrate:health": "wrangler d1 migrations apply yawamf-health-issues --remote"
  },
  "dependencies": {
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "miniflare": "4.20260730.0",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
