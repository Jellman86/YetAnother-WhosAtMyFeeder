{
  "name": "wamf-ui",
  "private": true,
  "version": "2.9.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:types": "python3 ../../backend/scripts/export_openapi_types.py",
    "api:types:check": "python3 ../../backend/scripts/export_openapi_types.py --check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --project=chromium",
    "test:browser:production": "playwright test -c playwright.production.config.ts",
    "check:cache": "node scripts/check-cache-stability.mjs",
    "lint:dead": "knip --no-progress --include files,dependencies,devDependencies,unlisted,unresolved,exports,types,nsExports,nsTypes,enumMembers",
    "lint:tokens": "vitest run src/design-tokens.ratchet.test.ts src/design-tokens.contrast.test.ts",
    "tokens:baseline": "UPDATE_TOKEN_BASELINE=1 vitest run src/design-tokens.ratchet.test.ts",
    "tokens:check-base": "node scripts/token-baseline.mjs check-against"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.4",
    "@types/leaflet": "^1.9.22",
    "knip": "^6.44.1",
    "postcss": "8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "hls.js": "^1.7.4",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "svelte-i18n": "^4.0.1"
  }
}
