{
  "name": "wamf-ui",
  "private": true,
  "version": "2.9.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:types": "python3 ../../backend/scripts/export_openapi_types.py",
    "api:types:check": "python3 ../../backend/scripts/export_openapi_types.py --check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:smoke": "playwright test --project=chromium",
    "lint:dead": "knip --no-progress --include files,dependencies,devDependencies,unlisted,unresolved,exports,types,nsExports,nsTypes,enumMembers"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/leaflet": "^1.9.22",
    "autoprefixer": "^10.6.2",
    "knip": "^6.43.0",
    "postcss": "^8.5.32",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "hls.js": "^1.7.4",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "svelte-i18n": "^4.0.1"
  }
}
